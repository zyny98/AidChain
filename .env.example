# ============================================================
# ClearGrant — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# ============================================================

# ---- Deployer / Oracle private keys ----
# Private key of the wallet that will deploy contracts (without 0x prefix)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Private key of the AI oracle wallet (used for signing milestone approvals)
ORACLE_PRIVATE_KEY=your_oracle_private_key_here

# ---- RPC URLs ----
# Polygon Amoy testnet RPC (get from Alchemy / Infura / QuickNode)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ---- Etherscan / Polygonscan API Key (for contract verification) ----
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ---- Optional: pre-deployed token address on Amoy ----
# Leave empty to deploy a fresh MockUSDC during the deploy script
MOCK_USDC_ADDRESS=

# ---- Optional: existing oracle address ----
# If not set, ORACLE_PRIVATE_KEY wallet address will be used
ORACLE_ADDRESS=
